# --- Sidekick demo (Appriss Retail) ---
# DEMO_MODE=true runs the scripted agent in server/demo.ts (no Snowflake needed).
# Set DEMO_MODE=false and fill in the SNOWFLAKE_* / AGENT_* values to use a live Cortex Agent.
DEMO_MODE=true

# --- Connection & auth (server only; never exposed to the browser) ---
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<user>
# One of: SNOWFLAKE_PAT (value), SNOWFLAKE_PAT_FILE (path to a file holding the PAT),
# or SNOWFLAKE_PRIVATE_KEY_PATH (key-pair JWT). Inside SPCS / App Runtime none is needed.
SNOWFLAKE_PAT=
SNOWFLAKE_PAT_FILE=/path/to/token.pat
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=ACME_DEMO_ROLE
SNOWFLAKE_WAREHOUSE=ACME_ASSIST_WH

# --- Agents ---
AGENT_DATABASE=ACME_ASSIST_DEMO
AGENT_SCHEMA=DATA
AGENT_NAME=ACME_ASSIST_AGENT
POWER_AGENT_NAME=ACME_POWER_AGENT
POWER_MODE_ENABLED=false
SEMANTIC_VIEW=ACME_ASSIST_DEMO.DATA.ACME_SEMANTIC_VIEW
VITE_BRAND=appriss

# --- Identity & history ---
TRUST_PROXY_HEADER=false
TRUSTED_USER_HEADER=X-Forwarded-User
REQUIRE_AUTH=false
DEV_USER=jordan.reyes
CALLERS_RIGHTS=false
HISTORY_STORE=local
HISTORY_ROLE=ACME_HISTORY_ROLE
HISTORY_TABLE=ACME_ASSIST_DEMO.APP.CONVERSATIONS

# --- Studio (optional CoCo runner) ---
COCO_RUNNER_URL=
PORT=8080
